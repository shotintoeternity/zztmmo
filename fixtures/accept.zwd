#..........................................................#
#..........................................................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    t = Torch color 0x06
    g = Gem color 0x0B
    a = Ammo color 0x03
    k = Key color cyan
    D = Door color cyan
    V = Object color 0x1E
    H = Bear color 0x06
    p = Passage color 0x1F to "Acceptance Target"
  end

  stats
    stat at 26,12 element Object cycle 3 p1 cp437:0x02 under Empty color 0x00
    oop
@vendor
#end
:touch
"Welcome to the Acceptance Vendor!"
!ba;Ammunition, 5 shots.........1 gem
#end
:ba
#take gems 1 else nocomp
#give ammo 5
"Thank you for buying ammo!"
#end
:nocomp
"You need a gem to buy ammo!"
#end
    end
    stat at 30,12 element Bear cycle 3 p1 4 under Empty color 0x00
    stat at 34,12 element Passage cycle 0 p3 board "Acceptance Target" under Empty color 0x00
  end
end

board "Acceptance Target"
  start player at 6,12
  max-shots 10
  dark false
  reenter false
