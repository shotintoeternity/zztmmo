zwd 1
world "ARENA"

# M30.1 first-party PvP room. Friendly-fire policy is server-owned; this file
# only makes that visible to players through ordinary ZZT space and signs.

board "Arena Title"
  start player at 30,15
  max-shots 10
  dark false
  reenter false
  time-limit 0
  exits north none south none west none east none

  grid
############################################################
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................ARENA...........................#
#..........................................................#
#...................FRIENDLY.FIRE.IS.ON....................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#.....................PRESS.P.TO.FIGHT.....................#
#..........................................................#
#............................@.............................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    A = Text-White color 0x41
    D = Text-White color 0x44
    E = Text-White color 0x45
    F = Text-White color 0x46
    G = Text-White color 0x47
    H = Text-White color 0x48
    I = Text-White color 0x49
    L = Text-White color 0x4C
    N = Text-White color 0x4E
    O = Text-White color 0x4F
    P = Text-White color 0x50
    R = Text-White color 0x52
    S = Text-White color 0x53
    T = Text-White color 0x54
    Y = Text-White color 0x59
  end

  stats
  end
end

board "Arena Floor"
  start player at 30,5
  max-shots 10
  dark false
  reenter false
  time-limit 0
  exits north none south none west none east none

  grid
############################################################
#.....................SAFE.READY.ROOM......................#
#......z...................................................#
#..........................................................#
#..............a...........a.@.a...........a...............#
#..............a...........................a...............#
#.....#####.......#######################.......#####......#
#.....#.............................................#......#
#.....#.............................................#......#
#.....#....aaaa.............eeee.............aaaa...#......#
#.....#.............................................#......#
#.....#.....#####......#####....#####......#####....#......#
#.....#.............................................#......#
#.....#................g..g......g..g...............#......#
#.....#.............................................#......#
#.....#.....#####......#####....#####......#####....#......#
#.....#.............................................#......#
#.....#....aaaa.............eeee.............aaaa...#......#
#.....#.............................................#......#
#.....#############.....###########.....#############......#
#..........................z...............................#
#............................p.............................#
#.....................RETURN.TO.LOBBY......................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    a = Ammo color 0x03
    e = Energizer color 0x05
    g = Gem color 0x0B
    p = Passage color 0x1E to "Arena Floor"
    z = Object color 0x1F
    A = Text-White color 0x41
    B = Text-White color 0x42
    D = Text-White color 0x44
    E = Text-White color 0x45
    F = Text-White color 0x46
    L = Text-White color 0x4C
    M = Text-White color 0x4D
    N = Text-White color 0x4E
    O = Text-White color 0x4F
    R = Text-White color 0x52
    S = Text-White color 0x53
    T = Text-White color 0x54
    U = Text-White color 0x55
    Y = Text-White color 0x59
  end

  stats
    stat at 8,3 element Object cycle 3 p1 cp437:0x02 under Empty color 0x00
    oop
@rules
#end
:touch
Arena rules:
Friendly fire is on here.
Shots can hit other players.
Shots never hurt the shooter.
Use the lower gate to return.
#end
    end
    stat at 28,21 element Object cycle 3 p1 cp437:0x02 under Empty color 0x00
    oop
@return
#end
:touch
The passage below returns to LOBBY.
Good fight.
#end
    end
    stat at 30,22 element Passage cycle 0 p3 board "Arena Floor" under Empty color 0x00
  end
end
