zwd 1
world "LOBBY"

# M29.1 first-party social hub. The browser routes and server transit table are
# the authority for cross-world travel; the passages here are visible ZZT gates.

board "Lobby Title"
  start player at 30,15
  max-shots 10
  dark false
  reenter false
  time-limit 0
  exits north none south none west none east none

  grid
############################################################
