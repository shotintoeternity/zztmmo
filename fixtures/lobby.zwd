#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    B = Text-White color 0x42
    E = Text-White color 0x45
    H = Text-White color 0x48
    I = Text-White color 0x49
    J = Text-White color 0x4A
    L = Text-White color 0x4C
    M = Text-White color 0x4D
    N = Text-White color 0x4E
    O = Text-White color 0x4F
    P = Text-White color 0x50
    R = Text-White color 0x52
    S = Text-White color 0x53
    T = Text-White color 0x54
    V = Text-White color 0x56
    Y = Text-White color 0x59
    Z = Text-White color 0x5A
  end

  stats
  end
end

board "Central Hall"
  start player at 30,13
  max-shots 10
  dark false
  reenter false
  time-limit 0
  exits north none south none west none east none

  grid
############################################################
#..........................................................#
#......................ZZTMMO.LOBBY........................#
#..........................................................#
#......CHAT..........FRIENDS..........WATCH.LIVE...........#
#..........................................................#
#..........................................................#
#..........................................................#
#..........p.................q.................r...........#
#..........................................................#
#..........................................................#
#..........................................................#
#............................@.............................#
#..........................................................#
#..........................................................#
#..........................................................#
#..............WELCOME..........TOWN..........DREAMS.......#
#..........................................................#
#..........................................................#
#..........................................................#
#............TOUCH.A.GATE.TO.JOIN.A.WORLD..................#
#..........................................................#
#..........................................................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    p = Passage color 0x1F to "Central Hall"
    q = Passage color 0x1E to "Central Hall"
    r = Passage color 0x1D to "Central Hall"
    A = Text-White color 0x41
    B = Text-White color 0x42
    C = Text-White color 0x43
    D = Text-White color 0x44
    E = Text-White color 0x45
    F = Text-White color 0x46
    G = Text-White color 0x47
    H = Text-White color 0x48
    I = Text-White color 0x49
    J = Text-White color 0x4A
    L = Text-White color 0x4C
    M = Text-White color 0x4D
    N = Text-White color 0x4E
    O = Text-White color 0x4F
    R = Text-White color 0x52
    S = Text-White color 0x53
    T = Text-White color 0x54
    U = Text-White color 0x55
    V = Text-White color 0x56
    W = Text-White color 0x57
    Y = Text-White color 0x59
    Z = Text-White color 0x5A
  end

  stats
    stat at 12,9 element Passage cycle 0 p3 board "Central Hall" under Empty color 0x00
    stat at 30,9 element Passage cycle 0 p3 board "Central Hall" under Empty color 0x00
    stat at 48,9 element Passage cycle 0 p3 board "Central Hall" under Empty color 0x00
  end
end
