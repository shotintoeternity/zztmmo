  end

  legend
    # = Solid color 0x0E
    . = Empty color 0x07
    @ = Player color 0x1F under Empty color 0x00
    o = Boulder color 0x0F
    b = Breakable color 0x0B
    g = Gem color 0x03
    N = Slider (NS) color 0x0F
    E = Slider (EW) color 0x0F
  end

  stats
  end
