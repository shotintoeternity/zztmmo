#G.........................................................#
#..........................................................#
#............................@.............................#
#..........................................................#
#..........................................................#
############################################################
  end

  legend
    # = Solid color 0x0E
    . = Empty color 0x07
    @ = Player color 0x1F under Empty color 0x00
    C = Clockwise color 0x0D
    c = Counter color 0x0D
    G = Spinning gun color 0x0D
    o = Boulder color 0x0F
    g = Gem color 0x03
  end

  stats
    stat at 10,8 element Clockwise cycle 3 under Empty color 0x00
    stat at 20,8 element Counter cycle 2 under Empty color 0x00
    stat at 40,13 element Spinning gun cycle 2 p1 8 p2 9 under Empty color 0x00
    stat at 2,20 element Spinning gun cycle 2 p1 8 p2 9 under Empty color 0x00
  end
end
