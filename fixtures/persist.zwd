  end

  legend
    # = Solid color 0x01
    . = Empty color 0x00
    @ = Player color 0x1F under Empty color 0x00
    R = Object color 0x1C
    g = Gem color 0x0B
    a = Ammo color 0x03
    t = Torch color 0x06
    p = Passage color 0x1F to "Persist Annex"
  end

  stats
    stat at 6,10 element Object cycle 3 p1 cp437:0x0F under Empty color 0x00
    oop
@reaper
#end
:touch
#endgame
#end
    end
    stat at 15,12 element Passage cycle 0 p3 board "Persist Annex" under Empty color 0x00
  end
end

